# ─────────────────────────────────────────────────────────────
# للاستضافة المشتركة (مثل Hostinger) حين يُرفع المشروع كاملًا داخل public_html:
# يحوّل كل الطلبات إلى مجلد public فلا تُفتح ملفات المشروع (.env وغيره) من المتصفح.
# على خادم يشير فيه الدومين إلى مجلد public مباشرة لا يُستخدم هذا الملف.
# ─────────────────────────────────────────────────────────────
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# حماية إضافية: منع أي ملف يبدأ اسمه بنقطة (.env، .git ...)
<IfModule mod_authz_core.c>
    <FilesMatch "^\.">
        Require all denied
    </FilesMatch>
</IfModule>
