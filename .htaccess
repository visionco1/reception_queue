<IfModule mod_rewrite.c>
    Options -Indexes
    RewriteEngine On

    # Force HTTPS
    RewriteCond %{HTTPS} off
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Send every request to the public folder, so files like .env,
    # vendor/ and storage/ in the project root can't be reached directly
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Deny any hidden file (.env, .git, ...)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
