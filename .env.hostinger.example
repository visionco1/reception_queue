# ═══════════════════════════════════════════════════════════════
#  إعدادات جاهزة للرفع على Hostinger (أو أي استضافة مشتركة)
#  انسخ هذا الملف باسم .env ثم عدّل الأسطر المعلَّمة بـ ← فقط
# ═══════════════════════════════════════════════════════════════

APP_NAME="نظام الاستقبال"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# ← رابط موقعك كما يظهر في المتصفح، بـ https
APP_URL=https://your-domain.com

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA
# ← Asia/Riyadh للسعودية، أو Africa/Cairo لمصر
APP_TIMEZONE=Asia/Riyadh

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning

# ← بيانات قاعدة البيانات من hPanel ← Databases (الاسم واليوزر يبدآن بـ u123456789_)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u123456789_reception
DB_USERNAME=u123456789_reception
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=600
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log

# ← كلمة مرور حساب المدير الأول (يُنشأ مرة واحدة عند db:seed) — غيّرها بعد أول دخول
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# واتساب: log = تجربة بدون إرسال | meta = إرسال فعلي (راجع README)
WHATSAPP_DRIVER=log
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

QMS_POLL_MS=2500
# مهم على الاستضافة المشتركة: يشغّل إرسال رسائل واتساب من الـ Cron بدل Supervisor
QMS_QUEUE_VIA_SCHEDULER=true
QMS_BACKUP_KEEP=14
